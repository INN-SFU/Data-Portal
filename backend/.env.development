# Backend Development Environment Variables
# Source of truth for all backend configuration in development

# ============================================
# Keycloak Configuration
# ============================================
# Keycloak connection for local development
KEYCLOAK_DOMAIN=http://localhost:8080
KEYCLOAK_REALM=ams-portal
KEYCLOAK_UI_CLIENT_ID=ams-portal-ui
KEYCLOAK_ADMIN_CLIENT_ID=ams-portal-admin

# Admin credentials (mandatory)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_ADMIN_CLIENT_SECRET=PhLbj8vraWnpbvPevBAERGj0g4rHcwAf

# Token issuers (must match JWT token claims)
# Frontend accesses Keycloak via localhost, so tokens are issued with this URL
KEYCLOAK_TOKEN_ISSUER=http://localhost:8080/realms/ams-portal
KEYCLOAK_EXTERNAL_ISSUER=http://localhost:8080/realms/ams-portal

# ============================================
# Backend Application Configuration
# ============================================
# Server binding
AMS_HOST=0.0.0.0
AMS_PORT=8000

# Runtime behavior
AMS_RELOAD=false

# Backend URL (for CORS, redirects, etc.)
BACKEND_BASE_URL=http://localhost:8000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# ============================================
# API Configuration
# ============================================
API_VERSION=0_1

# ============================================
# Casbin/Policy Configuration
# ============================================
ENFORCER_MODEL=./core/management/managers/policies/casbin/model.conf
ENFORCER_POLICY=./core/management/managers/policies/casbin/policy.csv
USER_POLICIES=./data/policies

# ============================================
# Storage Instance Configuration
# ============================================
INSTANCE_CONFIGS=./data/configs

# ============================================
# Development Features
# ============================================
# Enable smoke tests on startup
RUN_SMOKE_TESTS=true
