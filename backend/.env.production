# Backend Production Environment Variables
# Source of truth for all backend configuration in production

# ============================================
# Keycloak Configuration
# ============================================
# Production Keycloak URL (update with your production domain)
KEYCLOAK_DOMAIN=https://keycloak.rmcintos.cedar.researchcomputinggroup.ca
KEYCLOAK_REALM=ams-portal
KEYCLOAK_UI_CLIENT_ID=ams-portal-ui
KEYCLOAK_ADMIN_CLIENT_ID=ams-portal-admin

# Keycloak admin credentials (use secrets management in production)
# TODO: Replace with proper secrets management (Kubernetes secrets, AWS Secrets Manager, etc.)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Client secret location (populated at runtime by entrypoint script)
KEYCLOAK_ADMIN_CLIENT_SECRET=<CHANGE_ME_IN_PRODUCTION>

# Token issuers (must match JWT token claims)
KEYCLOAK_TOKEN_ISSUER=https://keycloak.rmcintos.cedar.researchcomputinggroup.ca/realms/ams-portal
KEYCLOAK_EXTERNAL_ISSUER=https://keycloak.rmcintos.cedar.researchcomputinggroup.ca/realms/ams-portal

# ============================================
# Backend Application Configuration
# ============================================
# Server binding
AMS_HOST=0.0.0.0
AMS_PORT=8000

# Runtime behavior (production settings)
AMS_RELOAD=false

# Backend URL (update with your production domain)
BACKEND_BASE_URL=https://ams-backend.rmcintos.cedar.researchcomputinggroup.ca

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=WARNING
LOG_DIR=/app/data/logs

# ============================================
# API Configuration
# ============================================
API_VERSION=0_1

# ============================================
# Casbin/Policy Configuration
# ============================================
ENFORCER_MODEL=/app/core/settings/managers/policies/casbin/model.conf
ENFORCER_POLICY=/app/core/settings/managers/policies/casbin/policy.csv
USER_POLICIES=/app/data/policies

# ============================================
# Storage Instance Configuration
# ============================================
INSTANCE_CONFIGS=/app/data/configs

# ============================================
# Production Features
# ============================================
# Disable smoke tests in production
RUN_SMOKE_TESTS=false
