# AMS Backend Environment Variables Template
# Copy to .env and fill in your values

# === REQUIRED VARIABLES ===
KEYCLOAK_DOMAIN=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-client-secret-here
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# === OPTIONAL VARIABLES ===
# Server Configuration
AMS_HOST=0.0.0.0
AMS_PORT=8000
AMS_RELOAD=false

# Keycloak Configuration
KEYCLOAK_REALM=ams-portal
KEYCLOAK_UI_CLIENT_ID=ams-portal-ui
KEYCLOAK_UI_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=ams-portal-admin

# Application Configuration
API_VERSION=0_1
SYSTEM_RESET=false
LOG_CONFIG=/app/loggers/log_config.yaml

# === VOLUME MOUNTS ===
# For persistent data, mount these paths:
# - /app/data/logs - Application logs
# - /app/data/configs - Instance configurations  
# - /app/data/policies - Policy configurations
# - /app/data/secrets - Security secrets