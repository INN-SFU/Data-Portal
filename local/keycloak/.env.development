# Keycloak Development Environment Variables

# Admin credentials (mandatory)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Database (dev-file for development) (optional)
KC_DB=dev-file

# Monitoring (optional)
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

# Logging (optional)
KC_LOG_LEVEL=INFO

# Hostname configuration (optional)
KC_HOSTNAME=localhost
KC_HOSTNAME_STRICT=false

# Realm configuration
KEYCLOAK_REALM=ams-portal
KEYCLOAK_ADMIN_CLIENT_ID=ams-portal-admin
KEYCLOAK_UI_CLIENT_ID=ams-portal-ui

# Internal service URL (for backend to connect) (mandatory)
KEYCLOAK_DOMAIN=http://keycloak:8080

KEYCLOAK_ADMIN_CLIENT_SECRET=<INSERT STRING HERE>
